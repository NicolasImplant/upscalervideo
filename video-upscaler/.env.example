# ── Entorno ────────────────────────────────────────────────
APP_ENV=production          # production | development
LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json             # json | console

# ── Google Cloud ───────────────────────────────────────────
GCP_PROJECT_ID=mi-proyecto
GCS_BUCKET_INPUT=mi-bucket-input
GCS_BUCKET_OUTPUT=mi-bucket-output
GCS_INPUT_PREFIX=input/
GCS_OUTPUT_PREFIX=output/
GCS_UPLOAD_TIMEOUT_SECONDS=300
GCS_DOWNLOAD_TIMEOUT_SECONDS=300
GCS_MAX_RETRY_ATTEMPTS=3

# ── Video processing ───────────────────────────────────────
VIDEO_NAME=mi_video.mp4
VIDEO_TARGET_SCALE=2             # 2 = 360→720, 4 = 360→1440
# VIDEO_SOURCE_FPS=              # dejar vacío = auto-detect via ffprobe
VIDEO_OUTPUT_FPS=30              # FPS de salida (y fallback si ffprobe falla)
VIDEO_OUTPUT_CRF=18              # 0=lossless, 51=peor, 18=excelente
VIDEO_OUTPUT_PRESET=slow         # ultrafast|fast|medium|slow|veryslow
VIDEO_OUTPUT_CODEC=libx264
VIDEO_OUTPUT_AUDIO_BITRATE=192k
VIDEO_OUTPUT_AUDIO_CODEC=aac

# ── Real-ESRGAN ────────────────────────────────────────────
ESRGAN_MODEL_NAME=RealESRGAN_x2plus
ESRGAN_MODEL_PATH=/models/RealESRGAN_x2plus.pth
ESRGAN_TILE_SIZE=256
ESRGAN_TILE_PAD=10
ESRGAN_PRE_PAD=0
ESRGAN_DEVICE=cuda               # cuda | cpu
ESRGAN_NUM_FEAT=64               # RRDBNet: feature channels
ESRGAN_NUM_BLOCK=23              # RRDBNet: residual blocks (x2plus=23, x4plus=23)
ESRGAN_NUM_GROW_CH=32            # RRDBNet: growth channels

# ── Audio enhancement ──────────────────────────────────────
AUDIO_ENABLE_ENHANCEMENT=true
AUDIO_DENOISER_STRENGTH=7        # anlmdn strength 1-15
AUDIO_DENOISER_PATCH_RADIUS=0.002
AUDIO_EQ_FREQUENCY=100
AUDIO_EQ_GAIN_DB=3
AUDIO_EQ_WIDTH=200

# ── FFmpeg / FFprobe ───────────────────────────────────────
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
FFMPEG_THREADS=0                 # 0 = auto
FFMPEG_LOGLEVEL=error            # quiet|error|warning|info|debug

# ── Paths temporales ───────────────────────────────────────
TMP_BASE_DIR=/tmp/upscaler
FRAMES_SUBDIR=frames
FRAMES_UPSCALED_SUBDIR=frames_up
FRAMES_FORMAT=png                # png (calidad máx) | jpg (menor tamaño)
AUDIO_RAW_FILENAME=audio_raw.aac
AUDIO_CLEAN_FILENAME=audio_clean.aac
INPUT_FILENAME=input.mp4

# ── Storage backend ────────────────────────────────────────
STORAGE_BACKEND=gcs              # gcs | local
LOCAL_STORAGE_INPUT_DIR=/data/input
LOCAL_STORAGE_OUTPUT_DIR=/data/output