# ── Python ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
*.egg
dist/
build/

# ── Entorno virtual ──────────────────────────────────────────────────────
venv/
.venv/
env/
.env/

# ── Variables de entorno ─────────────────────────────────────────────────
.env
# .env.example se trackea intencionalmente

# ── BasicSR — solo el wheel va al repo, no el clon completo ─────────────
BasicSR/

# ── wheels — solo basicsr, el resto pesan demasiado ─────────────────────
wheels/*.whl
!wheels/basicsr-1.4.2-py3-none-any.whl

# ── Modelos de IA — demasiado grandes para git ───────────────────────────
*.pth
*.pt
*.onnx
models/

# ── Temporales de procesamiento ──────────────────────────────────────────
/tmp/
/data/output/
/data/input/

# ── IDE ──────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.user

# ── OS ───────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ─────────────────────────────────────────────────────────────────
*.log
logs/
